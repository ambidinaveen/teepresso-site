# ==========================================================================
# Teepresso environment — copy to ".env" on the server and fill in real values.
# NEVER commit the real .env to git. Everything below is SAFE-OFF by default:
# the app runs fully without any of these set.
# ==========================================================================

# --- Core (REQUIRED in production) ---------------------------------------
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED=https://yourdomain.com,https://www.yourdomain.com
DJANGO_SSL_REDIRECT=1

# --- Database (PostgreSQL in production; omit all to use SQLite in dev) ----
POSTGRES_DB=teepresso
POSTGRES_USER=teepresso
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis: cache + Celery broker (omit to run Celery inline/eager) --------
REDIS_URL=redis://redis:6379/0

# --- Email (omit to print emails to the console in dev) -------------------
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Teepresso <hello@teepresso.in>

# ==========================================================================
# SAFE-BY-DEFAULT integration switches. Leave OFF until you have real,
# tested credentials. The site runs fully and safely with all of these off.
# ==========================================================================

# Online payments (Razorpay). 0 = checkout records an UNPAID ENQUIRY (safe);
# set to 1 ONLY with real keys connected and tested.
RAZORPAY=0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp: 'link' = safe wa.me click-links | 'api' = Business API (needs tokens).
WHATSAPP_MODE=link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# SMS gateway: 0 = OTP/alerts are logged only (printed), not really sent.
SMS_API=0

# E-Way Bill: 0 = over-threshold orders FLAGGED for manual filing (no fake bill).
EWAY_API=0

# OTP at registration / password reset: 0 = code shown on screen (dev).
OTP_VERIFY=0
