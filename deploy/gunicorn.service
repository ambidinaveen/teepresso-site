# /etc/systemd/system/teepresso.service
# systemd unit that keeps Gunicorn (Django) running and auto-restarts it.
# After editing:  sudo systemctl daemon-reload && sudo systemctl restart teepresso

[Unit]
Description=Teepresso Gunicorn daemon
After=network.target

[Service]
User=teepresso
Group=www-data
WorkingDirectory=/home/teepresso/teepresso_site
EnvironmentFile=/home/teepresso/teepresso_site/.env
ExecStart=/home/teepresso/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/teepresso.sock \
    config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
